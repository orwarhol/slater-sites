{
  "version": "1.2.0",
  "engine": "git-backed",
  "workspace": {
    "contentRoot": ".",
    "extension": "md",
    "framework": "astro"
  },
  "schema": {
    "fields": [
      {
        "name": "title",
        "required": true,
        "type": "string",
        "uiComponent": "text-input"
      },
      {
        "name": "description",
        "required": true,
        "type": "string",
        "uiComponent": "textarea"
      },
      {
        "name": "pubDate",
        "required": true,
        "type": "date",
        "uiComponent": "date-picker"
      },
      {
        "name": "updatedDate",
        "type": "date",
        "uiComponent": "date-picker"
      },
      {
        "name": "regionNote",
        "type": "string",
        "uiComponent": "textarea"
      },
      {
        "name": "translationStatus",
        "required": true,
        "options": [
          "source",
          "localized",
          "adapted",
          "needs-review"
        ],
        "type": "enum",
        "uiComponent": "segmented-control"
      },
      {
        "default": [],
        "items": "string",
        "name": "tags",
        "type": "array",
        "uiComponent": "tag-cloud"
      },
      {
        "name": "audience",
        "type": "string",
        "uiComponent": "text-input"
      }
    ],
    "strictValidation": true
  },
  "regionalization": {
    "allowedOriginLocales": [
      "en-us",
      "es-ar",
      "es-mx",
      "fr-fr",
      "fr-ca"
    ],
    "defaultSourceLocale": "en-us",
    "enabled": true,
    "familyOriginFallback": "after-matrix",
    "locales": [
      {
        "id": "en-us"
      },
      {
        "id": "es-ar"
      },
      {
        "id": "es-mx"
      },
      {
        "id": "fr-fr"
      },
      {
        "id": "fr-ca"
      }
    ],
    "originPolicy": "flexible",
    "routingPattern": "src/content/guides/{locale}/{slug}.md",
    "strategy": "directory",
    "variantCreation": {
      "allowedStartingPoints": [
        "origin",
        "fallback",
        "existing-variant"
      ],
      "materializeOn": "first-meaningful-save",
      "mode": "on-demand"
    }
  },
  "contentLibrary": {
    "collections": [
      {
        "contentRoot": "src/content/guides",
        "extension": "md",
        "extensions": [
          "md",
          "mdx"
        ],
        "fields": [
          "title",
          "description",
          "pubDate",
          "updatedDate",
          "regionNote",
          "translationStatus",
          "tags",
          "audience"
        ],
        "id": "src-content-guides",
        "label": "Guides",
        "surfaces": [
          "draft",
          "paste",
          "generate",
          "optimize",
          "regionalize"
        ],
        "bodyMedia": {
          "enabled": true,
          "surfaces": [
            "draft"
          ],
          "placement": "between-top-level-blocks",
          "pattern": "markdown-image",
          "assetRoot": "public",
          "altText": {
            "required": true,
            "decorativeAllowed": true
          },
          "caption": {
            "mode": "none"
          },
          "layout": {
            "mode": "site-default"
          }
        }
      }
    ]
  },
  "components": {
    "Video": {
      "label": "Video",
      "kind": "media.video",
      "insertable": true,
      "surfaces": [
        "draft"
      ],
      "allowedCollections": [
        "src-content-guides"
      ],
      "editableAttributes": {
        "src": {
          "type": "url",
          "uiComponent": "url-input"
        }
      },
      "children": {
        "mode": "none"
      },
      "defaultSnippet": "<Video src=\"https://youtube.com/placeholder\" />"
    }
  },
  "media": {
    "assetRoots": [
      {
        "id": "public",
        "label": "Public assets",
        "publicPrefix": "/",
        "readOnly": false,
        "systemPath": "public",
        "allowedCollections": [
          "src-content-guides"
        ]
      }
    ],
    "uploadPolicy": {
      "maxSizeBytes": 5242880,
      "allowedMimeTypes": [
        "image/jpeg",
        "image/png",
        "image/gif",
        "image/webp",
        "image/svg+xml"
      ],
      "allowedExtensions": [
        "jpg",
        "jpeg",
        "png",
        "gif",
        "webp",
        "svg"
      ],
      "namingStrategy": "{originalName}-{hash}.{ext}",
      "onCollision": "append-hash",
      "sanitizeSvg": true
    },
    "externalProviders": {
      "allowedDomains": [
        "youtube.com",
        "youtu.be"
      ],
      "allowedProtocols": [
        "https:"
      ],
      "allowRawIframes": false
    }
  },
  "generate": {
    "enabled": true
  }
}
