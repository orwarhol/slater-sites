{
  "name": "ian-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "postbuild": "node ../../scripts/patch-astro-server-entry.mjs dist/server/entry.mjs && node -e \"import { copyFileSync } from 'node:fs'; copyFileSync('.assetsignore', 'dist/.assetsignore');\"",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --maxWorkers=1",
    "test:all": "vitest run",
    "test:playwright": "playwright test --config playwright.config.ts",
    "test:playwright:worker": "playwright test --config playwright.worker.config.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "14.1.4",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.1.3",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  }
}
